{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css-files/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "javascript-files/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "alieninvasionpics/*",
      "use": "@vercel/static"
    },
    {
      "src": "images/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/privacy/", "dest": "/privacy.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/terms/", "dest": "/terms.html" },
    { "src": "/auth/meta/callback", "dest": "/auth-meta-callback.html" },
    { "src": "/auth/meta/callback/", "dest": "/auth-meta-callback.html" },
    { "src": "/auth/tiktok/callback", "dest": "/auth-tiktok-callback.html" },
    { "src": "/auth/tiktok/callback/", "dest": "/auth-tiktok-callback.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
